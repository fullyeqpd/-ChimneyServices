---
import { DISCLAIMER, CLOSING_RULE, PROJECT_OF } from '../lib/site';
interface Props { citedAs?: string | null }
const { citedAs } = Astro.props;
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <p><strong>Chimney.Services</strong> — the independent reference to chimney and fireplace law, state by state. We recommend no one and take no fees.</p>
      <p class="muted">{DISCLAIMER}</p>
      <p class="muted">{CLOSING_RULE}</p>
      <p class="cited">{citedAs ? `Laws cited as of ${citedAs}` : 'Laws cited as of the dates shown on each page'}</p>
      <p class="muted"><a href="https://fullyeqpd.com/" target="_blank" rel="noopener">{PROJECT_OF}</a></p>
    </div>
    <nav aria-label="Footer">
      <a href="/rights">Rights</a>
      <a href="/licensing">Licensing</a>
      <a href="/services">Services</a>
      <a href="/learn">Learn</a>
      <a href="/about">About</a>
      <a href="/companies">Companies</a>
      <a href="/professionals">Professionals</a>
      <a href="/data/rights-table.csv" download>Rights CSV</a>
      <a href="/llms.txt">llms.txt</a>
      <a href="/sitemap">Site map</a>
    </nav>
  </div>
</footer>
