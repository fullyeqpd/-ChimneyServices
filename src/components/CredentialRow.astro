---
// One certification on a registry record, in two shapes.
//
// The single claim is the same in both: a certification appears on the issuer's
// own public roster under this name, on the date shown. Where a number was
// supplied by the person rather than read off a roster, it is labelled as
// supplied and not checked. Where the issuer's public lookup shows no number at
// all, we say that instead of inventing one.
//
//  - variant="id"       one line on the ID block: check, name, number, date,
//                       issuer link. Nothing that needs a paragraph.
//  - variant="evidence"  the full note in Details: what we searched, what the
//                       page said, expiry, relevance, how to repeat it.
import Chip from './Chip.astro';
import {
  certNumberLine,
  hasCertNumber,
  dateOrDash,
  shortDate,
  monthYear,
  type RegistryCredential,
} from '../lib/registry';

interface Props {
  credential: RegistryCredential;
  variant?: 'id' | 'evidence';
  /** h3 in the main list, h4 under "Other bodies". Evidence variant only. */
  level?: 3 | 4;
}
const { credential: c, variant = 'evidence', level = 3 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const anchor = `credential-${c.issuer.toLowerCase()}`;
const numberLine = certNumberLine(c);
const isNumber = hasCertNumber(c);
const supplied = c.certNumberStatus === 'supplied-not-checked';
const checkedLabel = shortDate(c.checkedAt);
const expiryLabel = monthYear(c.issuerListedExpiry);
// On the ID line the issuer has to be readable in the name itself — "SPRAT
// Level 1 Rope Access Technician", not a bare "Level 1".
const idTitle = c.title.startsWith(c.issuer) ? c.title : `${c.issuer} ${c.title}`;
---
{variant === 'id' ? (
  <li class="idcred">
    <span class="idcred__mark" aria-hidden="true">{c.checkedAt ? '✓' : ''}</span>
    <span class="idcred__body">
      <span class="idcred__title">{idTitle}</span>
      <span class="idcred__meta">
        {isNumber && <span class="idcred__num">#{c.certNumber}</span>}
        {isNumber && supplied && <span class="idcred__supplied">supplied, not checked</span>}
        {checkedLabel ? (
          <span class="idcred__date">checked {checkedLabel}</span>
        ) : (
          <span class="idcred__date">no roster search run yet</span>
        )}
        {expiryLabel && <span class="idcred__date">issuer expiry {expiryLabel}</span>}
      </span>
    </span>
    {c.logo ? (
      <a class="idcred__logo" href={c.lookupUrl} rel="noopener" target="_blank">
        <img src={c.logo} alt={`${c.issuer} — ${c.issuerName} lookup`} height="28" loading="lazy" decoding="async" />
        <span class="visually-hidden">opens in a new tab</span>
      </a>
    ) : (
      <a class="idcred__link" href={c.lookupUrl} rel="noopener" target="_blank">
        <span aria-hidden="true">{c.issuer} ↗</span>
        <span class="visually-hidden">{c.issuer} — {c.issuerName} lookup, opens in a new tab</span>
      </a>
    )}
  </li>
) : (
  <article class="cred" id={anchor}>
    <p class="cred__head">
      <span class="cred__abbr">{c.issuer}</span>
      <span class="cred__issuer">{c.issuerName}</span>
      {c.checkedAt ? <Chip>Roster checked</Chip> : <Chip class="chip--flag">Not checked yet</Chip>}
    </p>
    <Heading>{c.title}</Heading>
    <dl class="cred__facts">
      <dt>Certificate number</dt>
      <dd>
        <span class={isNumber ? 'mono' : 'cred__nonumber'}>{numberLine}</span>
        {supplied && <span class="cred__supplied">SUPPLIED BY THIS PERSON — NOT CHECKED</span>}
        {!isNumber && (
          <span class="cred__pending">
            The issuer's public lookup displays no certificate number, so this record carries none. We do not invent one.
          </span>
        )}
      </dd>
      <dt>Roster check</dt>
      <dd>
        Found on the {c.issuer} roster, <span class="mono">{dateOrDash(c.checkedAt)}</span>
        {c.checkedAt ? (
          <>
            <span class="cred__pending">Searched by {c.checkedBy ?? 'Chimney.Services'} on the issuer's own public page. {c.evidenceNote}</span>
            {c.evidenceClass && (
              <span class="cred__evidence"><Chip>{c.evidenceClass}</Chip><span>Issuer's own public lookup, read by us on {c.checkedAt}.</span></span>
            )}
          </>
        ) : (
          <span class="cred__pending">
            No roster search has been run for this record yet, so nothing here has been found.{c.evidenceNote ? ` ${c.evidenceNote}` : ''}
          </span>
        )}
      </dd>
      <dt>Expiry</dt>
      <dd>
        Issuer lists expiry as <span class="mono">{dateOrDash(c.issuerListedExpiry)}</span>{c.issuerListedExpiry ? '' : ` (${c.expiryNote ?? 'not shown by public lookup'})`}
        <span class="cred__pending">
          {c.issuerListedExpiry
            ? "That date is the issuer's claim, copied from the issuer. It is not ours."
            : "No expiry is recorded here because the issuer does not publish one where we looked. Absence of a date is not a claim that the certification runs forever."}
        </span>
      </dd>
    </dl>
    <p class="cred__line"><span class="cred__line-label">What it is relevant to</span> {c.relevance}</p>
    <p class="cred__line"><span class="cred__line-label">Check it yourself</span> {c.lookupNote}</p>
    <p class="sources">
      <span class="sources__label">Issuer lookup</span>
      <span class="source"><Chip>{c.evidenceClass ?? 'REF'}</Chip><a href={c.lookupUrl} rel="noopener" target="_blank">{c.lookupLabel}</a></span>
    </p>
  </article>
)}

<style>
  /* ---------- variant="id": one line, nothing that wraps into a paragraph ---------- */
  .idcred {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr) auto;
    gap: 4px 10px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .idcred:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .idcred__mark {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--ink);
  }
  .idcred__body {
    min-width: 0;
  }
  .idcred__title {
    display: block;
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.35;
  }
  .idcred__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }
  .idcred__num {
    color: var(--ink);
  }
  .idcred__date {
    color: var(--muted);
  }
  .idcred__supplied {
    color: var(--ember);
  }
  /* The lookup link is the issuer's wordmark: a bordered chip, not a logo. */
  .idcred__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 28px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    white-space: nowrap;
    padding: 0 10px;
  }
  .idcred__link:hover,
  .idcred__link:focus-visible {
    border-color: var(--ember);
    color: var(--ember);
  }
  /* Where the issuer publishes a mark, the mark itself is the link. Shown as
     the issuer draws it — no grayscale, no recolouring. */
  .idcred__logo {
    display: inline-flex;
    align-items: center;
    align-self: center;
    justify-self: end;
    text-decoration: none;
  }
  .idcred__logo img {
    display: block;
    height: 28px;
    width: auto;
  }
  .idcred__logo:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 3px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- variant="evidence": the full note, in Details ---------- */
  .cred {
    border: 1px solid var(--rule);
    padding: 14px 16px;
    margin: 0 0 12px;
  }
  .cred__head {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: center;
    margin: 0 0 6px;
  }
  .cred__abbr {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    border: 1px solid var(--ink);
    padding: 3px 6px;
  }
  .cred__issuer {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .cred h3,
  .cred h4 {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 600;
    margin: 0 0 10px;
  }
  .cred__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0 0 10px;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 620px) {
    .cred__facts {
      grid-template-columns: 170px minmax(0, 1fr);
    }
  }
  .cred__facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 9px 0 0;
  }
  .cred__facts dd {
    margin: 0;
    padding: 2px 0 9px;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  @media (min-width: 620px) {
    .cred__facts dt,
    .cred__facts dd {
      padding: 9px 0;
      border-bottom: 1px solid var(--rule);
    }
    .cred__facts dt:last-of-type,
    .cred__facts dd:last-of-type {
      border-bottom: 0;
    }
  }
  .cred__nonumber {
    color: var(--muted);
  }
  .cred__supplied {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    border: 1px solid var(--ember);
    color: var(--ember);
    padding: 2px 5px;
    margin-left: 8px;
    vertical-align: 2px;
  }
  .cred__pending {
    display: block;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.5;
    margin-top: 2px;
  }
  .cred__evidence {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    align-items: baseline;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .cred__line {
    font-size: 0.92rem;
    max-width: var(--measure);
    margin: 0 0 8px;
    padding-left: 10px;
    border-left: 1px solid var(--rule);
  }
  .cred__line-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
  }
  .cred .sources {
    margin-bottom: 0;
  }
</style>
