---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  modified?: string | null;
  citedAs?: string | null;
  section?: 'rights' | 'licensing' | 'services' | 'learn' | 'about' | 'home';
  /** A page-specific share image, when the site mark is not the right one. */
  ogImage?: string | null;
  ogImageAlt?: string | null;
}
const { title, description, path, noindex, ogType, jsonLd, modified, citedAs, section, ogImage, ogImageAlt } =
  Astro.props;
const nav = [
  ['rights', '/rights', 'Rights'],
  ['licensing', '/licensing', 'Licensing'],
  ['services', '/services', 'Services'],
  ['learn', '/learn', 'Learn'],
  ['about', '/about', 'About'],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Zilla+Slab:wght@600;700&display=swap"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      ogType={ogType}
      jsonLd={jsonLd}
      modified={modified}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="brand" href="/" aria-label="Chimney.Services home">
          <Logo />
          <span>Chimney.Services</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map(([key, href, label]) => <a href={href} aria-current={section === key ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer citedAs={citedAs} />
  </body>
</html>
