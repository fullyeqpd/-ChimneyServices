---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  modified?: string | null;
  citedAs?: string | null;
  section?: 'rights' | 'licensing' | 'services' | 'learn' | 'about' | 'home' | 'professionals' | 'companies';
  /** A page-specific share image, when the site mark is not the right one. */
  ogImage?: string | null;
  ogImageAlt?: string | null;
}
const { title, description, path, noindex, ogType, jsonLd, modified, citedAs, section, ogImage, ogImageAlt } =
  Astro.props;
// The masthead carries the five things a reader came to do, in the order they
// do them: find your state, read what the job is, then the two pages that are
// not open yet. "Soon" is said in the link itself — muted ink and a small
// ember tag — rather than by hiding the link, so nobody clicks expecting a
// search and finds a waiting list. Rights, Licensing and About are reference
// rather than tasks, and live in the footer.
const nav = [
  { key: 'home', href: '/#start', label: 'Pick a state' },
  { key: 'services', href: '/services', label: 'Review a service' },
  { key: 'professionals', href: '/professionals', label: 'Find a professional', soon: true },
  { key: 'companies', href: '/companies', label: 'Find a company', soon: true },
  { key: 'learn', href: '/learn', label: 'Learn' },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Zilla+Slab:wght@600;700&display=swap"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      ogType={ogType}
      jsonLd={jsonLd}
      modified={modified}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="brand" href="/" aria-label="Chimney.Services home">
          <Logo />
          <span>Chimney.Services</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              class={'soon' in item && item.soon ? 'nav__link nav__link--soon' : 'nav__link'}
              aria-current={section === item.key ? 'page' : undefined}
            >
              {item.label}
              {'soon' in item && item.soon && <sup class="nav__soon">Soon</sup>}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer citedAs={citedAs} />
  </body>
</html>
