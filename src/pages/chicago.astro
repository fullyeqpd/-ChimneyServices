<script is:inline>
  (function () {
    // Gemini publishes no prefill parameter, so its button copies the prompt and
    // opens Gemini. "Copy prompt" does the same without opening anything. Same
    // mechanism as the registry record's verify block.
    var box = document.getElementById('ai-reviews');
    var status = document.getElementById('ai-reviews-status');
    function say(msg) {
      if (status) status.textContent = msg;
    }
    function copyPrompt(then) {
      var text = box ? box.getAttribute('data-prompt') : '';
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(
          function () { say('Prompt copied. Paste it in.'); if (then) then(); },
          function () { say('Could not copy — select the prompt text and copy it by hand.'); },
        );
      } else {
        say('Could not copy — select the prompt text and copy it by hand.');
      }
    }
    var gem = document.getElementById('ai-reviews-gemini');
    if (gem) {
      gem.addEventListener('click', function () {
        copyPrompt(function () { window.open('https://gemini.google.com/app', '_blank', 'noopener'); });
      });
    }
    var copy = document.getElementById('ai-reviews-copy');
    if (copy) copy.addEventListener('click', function () { copyPrompt(null); });
  })();
</script>
