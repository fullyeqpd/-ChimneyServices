---
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import BeforeYouRely from '../../components/BeforeYouRely.astro';
import PriceBlock from '../../components/PriceBlock.astro';
import { getLearnHubs, humanizeSlug, LEARN_TOPICS, VARIES_BY_STATE, type LearnHub } from '../../lib/learn';
import { plain } from '../../lib/markdown';
import { ORG_NAME, SITE_URL, abs, monthYear, DISCLAIMER } from '../../lib/site';

export function getStaticPaths() {
  return getLearnHubs().map((hub) => ({ params: { slug: hub.slug }, props: { hub } }));
}

interface Props { hub: LearnHub }
const { hub } = Astro.props;
const path = `/learn/${hub.slug}`;
const updatedLabel = monthYear(hub.updated) ?? hub.updated;
const updatedUpper = updatedLabel.toUpperCase();

const tagGlyph = (t: string) => (t.startsWith('NATIONAL') ? 'globe' : t === VARIES_BY_STATE ? 'landmark' : undefined);
const jumpLabel = (title: string) => {
  const head = title.split(/:|—| – /)[0].trim();
  if (head.length <= 32) return head;
  const cut = head.slice(0, 31);
  return `${cut.slice(0, cut.lastIndexOf(' ') > 12 ? cut.lastIndexOf(' ') : 31).replace(/[\s,;]+$/, '')}…`;
};

const published = getLearnHubs();
const related = LEARN_TOPICS.filter((t) => t.slug !== hub.slug).map((t) => ({ ...t, hub: published.find((h) => h.slug === t.slug) }));

// ---- JSON-LD
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ORG_NAME, item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: abs('/learn') },
    { '@type': 'ListItem', position: 3, name: hub.topicName, item: abs(path) },
  ],
};
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: hub.title,
  description: hub.description,
  abstract: plain(hub.intro),
  mainEntityOfPage: abs(path),
  url: abs(path),
  datePublished: hub.published,
  dateModified: hub.updated,
  inLanguage: 'en-US',
  author: { '@type': 'Organization', name: ORG_NAME, url: SITE_URL },
  publisher: { '@type': 'Organization', name: ORG_NAME, url: SITE_URL, '@id': `${SITE_URL}/#organization` },
  about: { '@type': 'Thing', name: hub.topicName },
  hasPart: hub.reads.map((r) => ({ '@type': 'WebPageElement', name: r.title, url: `${abs(path)}#${r.anchor}` })),
  isAccessibleForFree: true,
};
const faqLd = hub.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.text } })),
    }
  : null;
const jsonLd = [breadcrumbLd, articleLd, ...(faqLd ? [faqLd] : [])];
---
<Base title={hub.seoTitle} description={hub.metaDescription} path={path} ogType="article" jsonLd={jsonLd} modified={hub.updated} section="learn">
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/learn">LEARN</a> / {hub.topicName.toUpperCase()}
  </nav>

  <div class="layout">
    <div class="learn-main">
      <header>
        <h1>{hub.title}</h1>
        <p class="badge-date">Updated {updatedLabel}<span class="dot">·</span>National</p>
        {hub.tags.length > 0 && <p class="chips">{hub.tags.map((t) => <Chip glyph={tagGlyph(t)}>{t}</Chip>)}</p>}
      </header>

      <p class="lede learn-intro" id="intro" set:html={hub.introHtml} />

      <nav class="jump" id="jump" aria-label="Jump to a read">
        {hub.reads.map((r, i) => (
          <a class={`chip${i === 0 ? ' chip--active' : ''}`} href={`#${r.anchor}`} title={r.title}>{String(i + 1).padStart(2, '0')} {jumpLabel(r.title)}</a>
        ))}
        {hub.faq.length > 0 && <a class="chip" href="#faq">FAQ</a>}
      </nav>

      <div class="learn-reads" id="reads">
        {hub.reads.map((r) => (
          <article class="read learn-read" id={r.anchor} aria-labelledby={`${r.anchor}-title`}>
            <h2 id={`${r.anchor}-title`}>{r.title}</h2>
            <p class="read__meta">
              <a class="anchor-mark" href={`#${r.anchor}`} aria-label={`Link to this read: ${r.title}`}>#{r.anchor}</a>
              <span>UPDATED {updatedUpper}</span>
              {r.tags.map((t) => <Chip glyph={tagGlyph(t)}>{t}</Chip>)}
            </p>
            {r.tags.includes(VARIES_BY_STATE) && (
              <p class="state-line">State rules differ — see the <a href="/rights">50-state laws table</a>.</p>
            )}
            <div class="prose" set:html={r.html} />
            {r.priceItems.length > 0 && (
              <div class="price-blocks">
                {r.priceItems.map((p) => p.first
                  ? <PriceBlock slug={p.slug} id={p.blockId} />
                  : <p class="price-ref" data-price-slug={p.slug}><span class="price-ref__name">{humanizeSlug(p.slug)}:</span> <a href={`#${p.blockId}`}>See the researched range above ↑</a></p>)}
              </div>
            )}
            <div class="sources">
              <span class="sources__label">Sources</span>
              {r.sources.map((src) => (
                <span class="source"><Chip>{src.cls}</Chip><a href={src.url} rel="noopener" target="_blank">{src.label}</a></span>
              ))}
            </div>
          </article>
        ))}
      </div>

      {hub.faq.length > 0 && (
        <section aria-labelledby="faq" class="faq-section">
          <h2 id="faq">Frequently asked questions about {hub.topicName.toLowerCase()}</h2>
          <div class="faq">
            {hub.faq.map((f, i) => (
              <details id={f.id} open={i === 0}>
                <summary><h3>{f.q}</h3></summary>
                <div class="prose" set:html={f.html} />
                <p class="fineprint"><a class="anchor-mark" href={`#${f.id}`}>#{f.id}</a></p>
              </details>
            ))}
          </div>
        </section>
      )}

      <BeforeYouRely dateLabel={updatedLabel} variant="guide" />

      <section aria-labelledby="related" class="related">
        <h2 id="related">Related guides</h2>
        <ul class="topic-list">
          {related.map((t) => (
            <li>
              {t.hub ? (
                <>
                  <p class="kicker">Updated {monthYear(t.hub.updated)}</p>
                  <h3 class="topic-list__title"><a href={`/learn/${t.slug}`}>{t.hub.title}</a></h3>
                  <p>{t.hub.description}</p>
                </>
              ) : (
                <>
                  <p class="kicker">Being written</p>
                  <h3 class="topic-list__title">{t.name}</h3>
                  <p>{t.blurb}</p>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="rail" aria-label="About this guide">
      <div class="rail-card">
        <p class="kicker">State law</p>
        <h2>Read the law in your state</h2>
        <p>This guide covers national standards. Licensing, permits and home-sale rules differ by state — the 50-state table compares them.</p>
        <p><a class="button button--ghost" href="/rights">Chimney laws by state</a></p>
      </div>
      <div class="rail-card">
        <p class="kicker">Guide updates</p>
        <h2>When this guide changes, we'll tell you.</h2>
        <p>One email when a read on this page is corrected or a standard it cites is revised.</p>
        <EmailCapture id={`capture-learn-${hub.slug}`} />
      </div>
      <div class="rail-card">
        <p class="kicker">Disclaimer</p>
        <p>{DISCLAIMER}</p>
      </div>
    </aside>
  </div>
</Base>
