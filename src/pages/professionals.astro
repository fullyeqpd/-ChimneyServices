---
// /professionals — two audiences, in the order they arrive.
//
// A homeowner comes here to find somebody. A technician comes here to be
// findable. The homeowner goes first, because there are more of them and
// because the honest answer to their question — "not yet, here is everything
// that exists today" — is short.
//
// A record is an ID card for one claim and no more: a certification appears on
// the issuer's own public roster under this name, on the date shown. It is not
// a status, not a badge, and not for sale. Cards are not open yet: this is the
// waiting list for them. When they open a card will be $25, which buys the
// printed card and the postage — no place, no rank and no opinion of anybody.
import Base from '../layouts/Base.astro';
import BeforeYouRely from '../components/BeforeYouRely.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { ORG_NAME, SITE_URL, abs } from '../lib/site';
import { US_STATES, CREDENTIAL_OPTIONS, NO_FEE_LINE, NEVER_SOLD_LINE } from '../lib/waitlist';
import { getRecords, recordPath, orderedCredentials, certifiedLabel, specialtyLabel } from '../lib/registry';

const path = '/professionals';
const title = `Find a chimney professional, or join the ID card waiting list | ${ORG_NAME}`;
const description =
  "Find a certified chimney professional near you, or join the waiting list for an ID card: your certification checked against the issuer's own roster.";

const records = getRecords();
const sample = records[0];
const samplePath = sample ? recordPath(sample) : '/pro';

/** What each existing record shows in the results list: who, what, where. */
const found = records.map((r) => ({
  name: r.name,
  href: recordPath(r),
  credentials: orderedCredentials(r).map((c) => `${certifiedLabel(c)} · ${specialtyLabel(c)}`),
  employer: r.employer ?? null,
  where: r.employerLocation ?? null,
}));

const CARD_PRICE_LINE = 'COMING SOON · ID CARDS WILL BE $25 EACH · RECORD PAGE INCLUDED';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ORG_NAME, item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Chimney professionals' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${abs(path)}#page`,
    url: abs(path),
    name: title,
    description,
    isPartOf: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    about: {
      '@type': 'Thing',
      name: 'Registry records on Chimney.Services',
      description:
        "A dated note of what an issuer's own public roster showed for one person's certification, which anyone can repeat. It confers no status and is never sold.",
    },
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} section="professionals">
  <nav class="crumb" aria-label="Breadcrumb">CHIMNEY.SERVICES / CHIMNEY PROFESSIONALS</nav>

  <div class="wl-page">
    <h1>Chimney professionals — find one near you, or join the waiting list for your ID card</h1>
    <p class="lede">
      Two things live on this page. A search for homeowners, which opens state by state as records are made. And the
      way a technician gets a record: a page naming the certifications you hold, with the issuer's own public roster
      named as where we found each one — plus, when cards open, a card you can hand to somebody standing in their own
      hallway.
    </p>

    <!-- ================= A. Homeowners ================= -->
    <section class="wl-section" aria-labelledby="find-h" id="find">
      <p class="kicker">For homeowners</p>
      <h2 id="find-h">Find a professional near you</h2>
      <p>
        Pick your state. Nobody pays to appear in this search, nobody can pay to be higher in it, and we take no fee
        from anyone it returns.
      </p>

      <form class="find" id="find-form" method="get" action="/professionals" data-find>
        <div class="find__row">
          <p class="wl-field find__field">
            <label for="find-state">Your state<span class="wl-req" aria-hidden="true">*</span></label>
            <select id="find-state" name="state" required>
              <option value="">Choose your state</option>
              {US_STATES.map((s) => <option value={s.abbr}>{s.name}</option>)}
            </select>
          </p>
          <p class="wl-field find__field find__field--zip">
            <label for="find-zip">ZIP <span class="wl-opt">(optional)</span></label>
            <input
              id="find-zip"
              name="zip"
              type="text"
              inputmode="numeric"
              maxlength="10"
              autocomplete="postal-code"
              pattern="[0-9]{5}(-[0-9]{4})?"
            />
          </p>
          <p class="find__action">
            <button class="button" type="submit">Search</button>
          </p>
        </div>
      </form>

      <!-- The answer, in the DOM whether or not the script runs. The button
           names the state that was chosen; the list below it is the same list
           either way, because there is nothing to filter yet. -->
      <div class="find__panel" id="find-results" aria-live="polite">
        <p class="find__status mono" id="find-status">COMING SOON</p>
        <p class="find__lead">Search opens when the first records are in your state. Records that exist today:</p>
        <ul class="find__list">
          {found.map((r) => (
            <li class="find__record">
              <a class="find__name" href={r.href}>{r.name}</a>
              <span class="find__creds mono">{r.credentials.join(' · ')}</span>
              {(r.employer || r.where) && (
                <span class="find__where">{[r.employer, r.where].filter(Boolean).join(' · ')}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="fineprint">
          Each name above links to its record, which says what was checked, on what date, and what was not checked at
          all. {NEVER_SOLD_LINE}
        </p>
      </div>
    </section>

    <!-- ================= B. Professionals ================= -->
    <!-- #join was this page's only anchor before there were two audiences.
         Anything already pointing at it still lands on the waiting list. -->
    <span id="join" class="anchor-alias" aria-hidden="true"></span>
    <section class="wl-section" aria-labelledby="order-h" id="order">
      <p class="kicker">For professionals</p>
      <h2 id="order-h">Join the waiting list for your registry record and ID card</h2>
      <p>
        Your record page is free and always will be. The card is the physical version of it: one printed card with
        your record number and a QR code that opens the page, for the doorstep conversation that happens before
        anyone gets out a phone.
      </p>
      <p class="price-line mono">{CARD_PRICE_LINE}</p>

      <p>
        When cards open, you'll get an email with a link to order; nothing is charged now, and nothing is charged for
        the record page itself.
      </p>

      <WaitlistForm
        type="professional"
        id="professional-waitlist"
        opensLabel="ID cards"
        button="Join the waiting list"
        success="You're on the list. We'll email {email} when ID cards open — $25 each, record page included."
        fieldsClass="wl-fields--two"
      >
        <p class="wl-field">
          <label for="wl-name">Your name<span class="wl-req" aria-hidden="true">*</span></label>
          <input id="wl-name" name="name" type="text" required maxlength="120" autocomplete="name" />
          <span class="wl-hint">Spell it the way the issuer's roster spells it, if that differs.</span>
        </p>
        <p class="wl-field">
          <label for="wl-pro-email">Email<span class="wl-req" aria-hidden="true">*</span></label>
          <input id="wl-pro-email" name="email" type="email" required maxlength="160" autocomplete="email" />
        </p>
        <p class="wl-field">
          <label for="wl-employer">Employer <span class="wl-opt">(optional)</span></label>
          <input id="wl-employer" name="employer" type="text" maxlength="120" autocomplete="organization" />
        </p>
        <p class="wl-field">
          <label for="wl-pro-state">State<span class="wl-req" aria-hidden="true">*</span></label>
          <select id="wl-pro-state" name="state" required autocomplete="address-level1">
            <option value="">Choose a state</option>
            {US_STATES.map((s) => <option value={s.abbr}>{s.name}</option>)}
          </select>
        </p>

        <fieldset class="wl-checks wl-field--wide" id="wl-credentials">
          <legend class="wl-legend">Certifications held<span class="wl-req" aria-hidden="true">*</span></legend>
          {CREDENTIAL_OPTIONS.map((c, i) => (
            <label class="wl-check" for={`wl-cred-${i}`}>
              <input id={`wl-cred-${i}`} type="checkbox" name="credentials" value={c.value} data-credential />
              <span>{c.label}</span>
            </label>
          ))}
        </fieldset>

        <p class="wl-field wl-field--wide">
          <label for="wl-certnums">Certificate number(s) <span class="wl-opt">(optional)</span></label>
          <input id="wl-certnums" name="certNumbers" type="text" maxlength="200" placeholder="SPRAT 2602623" />
          <span class="wl-hint">Only where the issuer publishes one. Several can go on one line, separated by commas.</span>
        </p>

      </WaitlistForm>

      <p class="fineprint">
        Nothing is charged now, and nothing is ever charged for the record page — that is free at every stage. Before
        any card is printed we search the issuer's own public roster for the certifications you name. If the
        certification is found there, we email you a way to pay the $25. If it is not found, we write and tell you
        what the issuer's page showed, and there is nothing to pay.
      </p>
      <p class="fineprint">{NO_FEE_LINE}</p>

      <!-- What is being ordered, shown rather than described. -->
      <figure class="cards">
        <figcaption class="cards__caption"><span class="kicker">What the card looks like</span></figcaption>
        <div class="cards__item">
          <a href="/pro/cards/art-kalina-simple.png">
            <img
              src="/pro/cards/art-kalina-simple.png"
              alt="A Chimney.Services ID card for record CS-P-00001: the name Art Kalina, the line Chimney Monkey · Buffalo Grove, IL, two certification lines reading NFI Woodburning Specialist and SPRAT Level 1 · #2602623, and a QR code labelled SCAN TO CHECK · CS-P-00001."
              width="1012"
              height="638"
              loading="lazy"
              decoding="async"
            />
          </a>
          <p class="cards__label mono">REAL RECORD &#183; CS-P-00001</p>
        </div>
        <figcaption class="fineprint cards__note">
          Example: the founder's own record, CS-P-00001. Scan it &#8212; it opens the record this site holds for him.
        </figcaption>
      </figure>
    </section>

    <section class="wl-section" aria-labelledby="what-h" id="what-you-get">
      <h2 id="what-h">What are you waiting for, exactly?</h2>
      <p>
        A record like <a href={samplePath}>{samplePath}</a> — open it first, then decide whether you want one. It makes
        a single claim, printed on the page: a certification appears on the issuer's own public roster under this name,
        on the date shown, with the certificate number where the issuer publishes one. That is the whole claim.
      </p>
      <ul class="wl-list">
        <li>
          <span class="wl-list__label">The check</span>
          We search the issuer's own public roster — NCSG, NFI, CSIA, SPRAT or another body — for the name and, where
          the issuer takes one, the certificate number. We write down what the issuer's page showed and the date we
          looked, including any expiry the issuer itself publishes.
        </li>
        <li>
          <span class="wl-list__label">What is missing</span>
          Bodies are listed in a fixed order — NCSG, then NFI, then CSIA, then any other body — with "none on record"
          printed for the ones you do not hold, so a reader sees the gaps as plainly as the certifications.
        </li>
        <li>
          <span class="wl-list__label">Your own words, labeled</span>
          Employer, role, years in the trade and a photograph are shown under a heading that says they were supplied by
          you and not checked by us. We do not repeat them as fact.
        </li>
        <li>
          <span class="wl-list__label">The card, when it opens — $25</span>
          One printed card carrying your record number, the certifications as the issuers name them, the date the
          rosters were checked, and a QR code that opens your record page. Cards are not open yet; the price will be
          $25 each when they are. It is a card, not a licence and not a permission to work.
        </li>
        <li>
          <span class="wl-list__label">Verification anyone can repeat</span>
          A row of buttons hands any reader — or their AI assistant — the full text of the search, together with a
          machine-readable copy of the record. The prompt is printed on the page in plain text: nothing is hidden in
          it, and it tells the assistant not to conclude "safe to hire" and not to call anyone verified.
        </li>
      </ul>
      <p>{NEVER_SOLD_LINE} A record confers no status on anybody, and it is not a licence, an approval, or a rank.</p>
    </section>

    <section class="wl-section" aria-labelledby="notchecked-h" id="not-checked">
      <h2 id="notchecked-h">What is not checked</h2>
      <p>
        Four things a reader might assume a record covers. It covers none of them: <strong>identity</strong> — we match a name to a roster, not a face to a name; <strong>criminal background</strong> — we run no background check of any kind, and are not a background screener
        or a consumer reporting agency; <strong>work quality</strong> — we inspect no work, call no customer, and read no complaint history; <strong>insurance</strong> — we check no policy, and cover belongs to a company rather than a person.
      </p>
    </section>

    <BeforeYouRely variant="waitlist" />

    <p class="wl-crosslink">
      Do you own the company rather than work at one? <a href="/companies">Join the company waiting list</a>.
    </p>
  </div>
</Base>

<style>
  /* ---------- A. Find a professional ---------- */
  .find {
    margin: 18px 0 0;
  }
  .find__row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px 16px;
  }
  .find__field {
    margin: 0;
    min-width: 220px;
  }
  .find__field--zip {
    min-width: 120px;
    max-width: 160px;
  }
  .find__action {
    margin: 0;
  }
  .find__action .button {
    padding: 11px 20px;
  }
  .find__panel {
    border-top: 1px solid var(--ink);
    margin: 22px 0 0;
    padding: 14px 0 0;
  }
  .find__panel:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 4px;
  }
  .find__status {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 6px;
  }
  .find__lead {
    margin: 0 0 12px;
  }
  .find__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .find__record {
    display: grid;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .find__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .find__creds {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .find__where {
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* ---------- B. Order the card ---------- */
  .anchor-alias {
    display: block;
    height: 0;
  }
  .price-line {
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: 10px 0;
    margin: 16px 0 22px;
  }
  /* ---------- What the card looks like ---------- */
  .cards {
    margin: 30px 0 0;
    border-top: 1px solid var(--ink);
    padding-top: 14px;
  }
  .cards__caption {
    margin-bottom: 12px;
  }
  .cards__item {
    max-width: 560px;
  }
  .cards__item img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .cards__label {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 6px 0 0;
  }
  .cards__note {
    margin-top: 14px;
  }
</style>

<script is:inline>
  (function () {
    // "Certifications held" is a group, and HTML has no required attribute for
    // a group. The first box carries the message so reportValidity has
    // somewhere to point.
    var group = document.getElementById('wl-credentials');
    if (group) {
      var boxes = [].slice.call(group.querySelectorAll('[data-credential]'));
      if (boxes.length) {
        var sync = function () {
          var any = boxes.some(function (b) {
            return b.checked;
          });
          boxes[0].setCustomValidity(any ? '' : 'Choose at least one certification, or "Other body".');
        };
        boxes.forEach(function (b) {
          b.addEventListener('change', sync);
        });
        sync();
      }
    }

    // The search. There is nothing to search yet, so the button's whole job is
    // to say so in the reader's own state and move them to the answer. With
    // the script off the form is a plain GET back to this page, and the answer
    // is already sitting below it.
    var form = document.querySelector('[data-find]');
    var status = document.getElementById('find-status');
    var panel = document.getElementById('find-results');
    if (!form || !status || !panel) return;
    var sel = form.querySelector('#find-state');
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      if (form.reportValidity && !form.reportValidity()) return;
      var opt = sel && sel.options[sel.selectedIndex];
      var where = opt && opt.value ? opt.text : null;
      status.textContent = where ? 'COMING SOON · ' + where.toUpperCase() : 'COMING SOON';
      panel.setAttribute('tabindex', '-1');
      panel.focus();
    });
  })();
</script>
