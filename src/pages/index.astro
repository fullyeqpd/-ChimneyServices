---
// Home. The first step is "go to your state", not "compare fifty".
//
// A reader arrives with one state in mind — their own — so the state control
// sits directly under the H1, above the national comparison. The four-column
// state index sits under the control: the select and its button need
// JavaScript, the index does not, so every state is one click away either way.
import Base from '../layouts/Base.astro';
import Chip from '../components/Chip.astro';
import Glyph from '../components/Glyph.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { getStates } from '../lib/content';
import { ORG_NAME, SITE_URL, CLOSING_RULE, monthYear, latest, RIGHTS_CSV } from '../lib/site';

const states = await getStates();
const lastVerified = latest(states.map((s) => s.lastVerified));
const title = `Chimney & Fireplace Laws by State — Know Your Rights | ${ORG_NAME}`;
const description = 'Chimney.Services: an independent reference to chimney and fireplace laws in every state. No fees, no sponsors, every fact sourced.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: ORG_NAME,
    url: SITE_URL,
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
];
---
<Base title={title} description={description} path="/" jsonLd={jsonLd} modified={lastVerified} citedAs={monthYear(lastVerified)} section="home">
  <p class="crumb">CHIMNEY.SERVICES / STATE LAWS REFERENCE</p>
  <h1>Before anyone goes on your roof, know what the law in your state actually says.</h1>

  <section class="state-start" id="start" aria-labelledby="start-h">
    <p class="kicker">Start here</p>
    <h2 id="start-h">Start with your state</h2>
    <p>Chimney law is state law. Pick yours and read it: who needs a license, what a seller must tell you, how long you have to cancel a door-knock sale, and when a carbon monoxide alarm is required.</p>

    <div class="state-start__row">
      <p class="wl-field state-start__field">
        <label for="state-go">Your state</label>
        <select id="state-go" name="state" autocomplete="address-level1">
          <option value="">Choose your state</option>
          {states.map((s) => <option value={s.slug} data-abbr={s.abbr}>{s.name}</option>)}
        </select>
      </p>
      <p class="state-start__action">
        <button class="button" type="button" id="state-go-btn">Go to my state</button>
      </p>
    </div>
    <p class="state-start__note" id="state-go-note" hidden></p>

    <h3 id="state-index-h" class="state-start__index-h">Or pick your state from the list</h3>
    <ul class="state-index" aria-labelledby="state-index-h">
      {states.map((s) => <li><a href={`/${s.slug}/rights`}>{s.name}</a></li>)}
    </ul>
  </section>

  <p class="lede">
    Chimney.Services is an independent, state-by-state reference to chimney and fireplace law: who needs a license, what a seller must tell you, how to cancel a door-knock sale, and when a carbon monoxide alarm is required.
  </p>
  <p class="chips"><Chip kind="muted">Public record</Chip><Chip kind="national" /><span class="fineprint">Laws cited as of {monthYear(lastVerified)}</span></p>

  <div class="grid-2" style="margin-top:32px">
    <section class="box box--ink" aria-labelledby="compare-h">
      <p class="kicker">Every state at once</p>
      <h2 id="compare-h">Or compare all 50 states + DC</h2>
      <p>The comparison table, the national findings, and a page for each state with statutes cited and primary sources linked.</p>
      <p class="chips">
        <a class="button" href="/rights">See the laws by state <Glyph name="arrow" /></a>
        <a class="button button--ghost" href={RIGHTS_CSV} download><Glyph name="download" /> CSV</a>
      </p>
    </section>
    <section class="box" aria-labelledby="notify-h">
      <p class="kicker">Stay current</p>
      <h2 id="notify-h">Laws change. We re-check them.</h2>
      <p>Every state page is dated and re-verified against the statute. Get one email when your state's chimney or fireplace law changes, or when a new section is published.</p>
      <EmailCapture id="capture-home" />
    </section>
  </div>


  <section aria-labelledby="how-h" style="margin-top:40px">
    <h2 id="how-h">How does Chimney.Services work?</h2>
    <ul class="topic-list">
      <li><strong>We recommend no one and take no fees.</strong> No certification body, guild, or contractor pays us, and no one can pay to be mentioned.</li>
      <li><strong>Every fact carries its provenance.</strong> On this laws site, everything is <span class="chip chip--muted">Public record</span> — statutes, regulations, registries and official forms, each dated.</li>
      <li><strong>We say what we haven't checked.</strong> {CLOSING_RULE}</li>
    </ul>
  </section>

</Base>

<script is:inline>
  (function () {
    var sel = document.getElementById('state-go');
    var btn = document.getElementById('state-go-btn');
    var note = document.getElementById('state-go-note');
    if (!sel || !btn) return;

    function say(text) {
      if (!note) return;
      note.textContent = text;
      note.hidden = false;
    }
    function setLabel() {
      var opt = sel.options[sel.selectedIndex];
      btn.textContent = opt && opt.value ? 'Go to ' + opt.text + ' →' : 'Go to my state';
    }
    function remember(slug) {
      try {
        localStorage.setItem('cs.state', slug);
      } catch (e) {
        /* private mode, or storage switched off: the control still works. */
      }
    }

    // Nobody is redirected on a guess. A network-level guess is wrong often
    // enough that sending a reader straight to the wrong state's law would
    // strand them there, wondering why they are reading about Ohio. We
    // pre-select, say where the guess came from, and wait for the click.
    btn.addEventListener('click', function () {
      var slug = sel.value;
      if (!slug) {
        sel.focus();
        say('Choose a state first.');
        return;
      }
      remember(slug);
      window.location.href = '/' + slug + '/rights';
    });

    sel.addEventListener('change', function () {
      setLabel();
      if (sel.value) {
        remember(sel.value);
        say('Your choice · remembered on this device');
      }
    });

    var stored = null;
    try {
      stored = localStorage.getItem('cs.state');
    } catch (e) {
      stored = null;
    }
    if (stored && sel.querySelector('option[value="' + String(stored).replace(/[^a-z-]/g, '') + '"]')) {
      sel.value = stored;
      setLabel();
      say('Your last choice · change it any time');
      return;
    }

    fetch('/api/geo', { headers: { Accept: 'application/json' } })
      .then(function (res) {
        return res.ok ? res.json() : null;
      })
      .then(function (geo) {
        if (!geo || geo.country !== 'US' || typeof geo.regionCode !== 'string') return;
        if (!/^[A-Z]{2}$/.test(geo.regionCode)) return;
        var opt = sel.querySelector('option[data-abbr="' + geo.regionCode + '"]');
        if (!opt) return;
        sel.value = opt.value;
        setLabel();
        say('Detected from your connection · change if wrong');
      })
      .catch(function () {
        /* No answer, or no network: the select stays on "Choose your state". */
      });
  })();
</script>
