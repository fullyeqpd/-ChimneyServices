---
import Base from '../../../layouts/Base.astro';
import { getRecords, recordPath, recordUrl, recordCardPath, cardSvgPath, type RegistryRecord } from '../../../lib/registry';
import { frontSvg, backSvg, CARD_W, CARD_H } from '../../../lib/card-svg.mjs';
import { ORG_NAME } from '../../../lib/site';

export function getStaticPaths() {
  return getRecords().map((record) => ({ params: { slug: record.slug }, props: { record } }));
}

interface Props { record: RegistryRecord }
const { record: rec } = Astro.props;
const path = recordCardPath(rec);
const url = recordUrl(rec);
const front = frontSvg(rec);
const back = backSvg(rec, url);

const title = `Registry card ${rec.recordNumber} — print sheet | ${ORG_NAME}`;
const description = `Print-ready CR80 card for registry record ${rec.recordNumber}. Front and back at exact card size, with SVG files for a print shop.`;
---
<Base title={title} description={description} path={path} noindex>
  <nav class="crumb no-print" aria-label="Breadcrumb">
    <a href={recordPath(rec)}>REGISTRY / RECORD {rec.recordNumber}</a> / CARD
  </nav>

  <div class="card-page">
    <header class="no-print">
      <h1>Registry card — {rec.recordNumber}</h1>
      <p class="badge-date">CR80 · {CARD_W} × {CARD_H} MM · 3.375 × 2.125 IN · NO EXPIRY PRINTED</p>
    </header>

    <div class="cards">
      <div class="card-stage">
        <p class="card-stage__label no-print">Front</p>
        <div class="card" set:html={front} />
      </div>
      <div class="card-stage">
        <p class="card-stage__label no-print">Back</p>
        <div class="card" set:html={back} />
      </div>
    </div>

    <div class="card-notes no-print">
      <p class="lede">
        The card's only job is to carry an address. It states no expiry, confers no status, and proves nothing about the person
        named on it. Everything a reader might act on lives on <a href={recordPath(rec)}>the record</a>.
      </p>
      <div class="band">
        <p class="band__title">Printing</p>
        <p>
          Use your browser's Print command. The page is set to one card per sheet at exact CR80 size, front first, back second —
          print double-sided, or print both and mount back to back. Turn off "fit to page" and any scaling, or the card will come
          out the wrong size.
        </p>
      </div>
      <p class="card-files">
        <a class="button" href={cardSvgPath(rec, 'front')} download>Front (SVG)</a>
        <a class="button" href={cardSvgPath(rec, 'back')} download>Back (SVG)</a>
      </p>
      <p class="fineprint">
        The SVG files are the same artwork, at exact size, for a print shop. They call for Zilla Slab, Archivo and IBM Plex Mono
        and fall back to a serif, a sans and a monospace if those are not installed — ask the shop to confirm the fonts before a run.
        On screen the cards are shown at up to twice real size; printed, they come out at exactly {CARD_W} × {CARD_H} mm.
      </p>
    </div>
  </div>
</Base>

<style define:vars={{ cardW: `${CARD_W}mm`, cardH: `${CARD_H}mm` }}>
  .card-page header {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 16px;
    margin-bottom: 26px;
  }
  .card-notes {
    max-width: 760px;
    margin-top: 32px;
    border-top: 1px solid var(--ink);
    padding-top: 20px;
  }
  .card-notes .lede {
    color: var(--muted);
  }
  .card-files .button + .button {
    margin-left: 8px;
  }
  .cards {
    display: grid;
    gap: 28px 32px;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 1040px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, calc(var(--cardW) * 2)));
    }
  }
  .card-stage {
    margin: 0;
    min-width: 0;
  }
  .card-stage__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 8px;
  }
  /* On screen: 2× the real card, on a hairline frame. */
  .card {
    border: 1px solid var(--rule);
    width: calc(var(--cardW) * 2);
    max-width: 100%;
    line-height: 0;
  }
  /* Direct child only — the mark inside the artwork is a nested <svg>. */
  .card > :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .cards {
      display: block;
    }
    .card-stage {
      margin: 0;
      break-after: page;
      page-break-after: always;
    }
    .card-stage:last-child {
      break-after: auto;
      page-break-after: auto;
    }
    .card {
      border: 0;
      width: var(--cardW);
      height: var(--cardH);
    }
    .card > :global(svg) {
      width: var(--cardW);
      height: var(--cardH);
    }
  }
</style>

<style is:global>
  @page {
    size: 85.6mm 53.98mm;
    margin: 0;
  }
  @media print {
    html,
    body {
      background: #fff;
      margin: 0;
      padding: 0;
    }
    .masthead,
    .footer,
    .skip {
      display: none !important;
    }
    main.wrap {
      max-width: none;
      padding: 0;
      margin: 0;
    }
  }
</style>
