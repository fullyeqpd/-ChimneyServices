---
import Base from '../../layouts/Base.astro';
import BeforeYouRely from '../../components/BeforeYouRely.astro';
import CredentialRow from '../../components/CredentialRow.astro';
import {
  getRecords,
  ISSUER_ORDER,
  RECORD_CLAIM,
  recordPath,
  recordUrl,
  recordJsonPath,
  dateOrDash,
  shortDate,
  roleLine,
  orderedCredentials,
  verifyPrompt,
  type RegistryRecord,
  type RegistryCredential,
} from '../../lib/registry';
import { ORG_NAME, SITE_URL, abs } from '../../lib/site';

export function getStaticPaths() {
  return getRecords().map((record) => ({ params: { slug: record.slug }, props: { record } }));
}

interface Props { record: RegistryRecord }
const { record: rec } = Astro.props;
const path = recordPath(rec);

// The ID block lists the certifications that exist, in the fixed body order.
const idCredentials = orderedCredentials(rec);

// Details keeps the full order, with the empty bodies left visible so a reader
// can see what is missing as easily as what is there.
const byIssuer = new Map(rec.credentials.map((c) => [c.issuer, c]));
const noneByIssuer = new Map(rec.noneOnRecord.map((n) => [n.issuer, n]));
type Row =
  | { kind: 'credential'; credential: RegistryCredential }
  | { kind: 'none'; issuer: string; issuerName: string };
const orderedRows: Row[] = ISSUER_ORDER.map((issuer) => {
  const credential = byIssuer.get(issuer);
  if (credential) return { kind: 'credential', credential } as Row;
  const none = noneByIssuer.get(issuer);
  return { kind: 'none', issuer, issuerName: none?.issuerName ?? issuer } as Row;
});
const otherRows = rec.credentials.filter((c) => !ISSUER_ORDER.includes(c.issuer as (typeof ISSUER_ORDER)[number]));

const prompt = verifyPrompt(rec);
const jsonPath = recordJsonPath(rec);
const role = roleLine(rec);
const photoSrc = rec.photo.thumbUrl ?? rec.photo.url;

const title = `Registry record ${rec.recordNumber} — ${rec.name} | ${ORG_NAME}`;
const description = `Registry record ${rec.recordNumber}: what ${ORG_NAME} found when it searched issuer rosters for ${rec.name}. Not an endorsement.`;

// ---- JSON-LD
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ORG_NAME, item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: `Registry record ${rec.recordNumber}`, item: recordUrl(rec) },
  ],
};
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': recordUrl(rec),
  name: rec.name,
  alternateName: rec.nameOnRosters,
  givenName: rec.preferredName,
  identifier: rec.recordNumber,
  mainEntityOfPage: recordUrl(rec),
  url: recordUrl(rec),
  disambiguatingDescription: RECORD_CLAIM,
  ...(rec.role ? { jobTitle: rec.role } : {}),
  ...(rec.employer
    ? {
        worksFor: {
          '@type': 'Organization',
          name: rec.employer,
          ...(rec.employerLocation ? { address: rec.employerLocation } : {}),
        },
      }
    : {}),
  ...(rec.activeSince ? { knowsAbout: `Chimney services, reported by this person as their trade since ${rec.activeSince}` } : {}),
  hasCredential: rec.credentials.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.title,
    credentialCategory: 'certification',
    ...(c.certNumber && c.certNumberStatus !== 'placeholder' ? { identifier: c.certNumber } : {}),
    url: c.lookupUrl,
    recognizedBy: { '@type': 'Organization', name: c.issuerName, alternateName: c.issuer, url: c.lookupUrl },
    ...(c.issuerListedExpiry ? { expires: c.issuerListedExpiry } : {}),
    ...(c.checkedAt ? { dateCreated: c.checkedAt } : {}),
  })),
  subjectOf: {
    '@type': 'WebPage',
    '@id': `${recordUrl(rec)}#record`,
    url: recordUrl(rec),
    name: `Registry record ${rec.recordNumber}`,
    description: RECORD_CLAIM,
    dateCreated: rec.recordCreated,
    publisher: { '@type': 'Organization', name: ORG_NAME, url: SITE_URL, '@id': `${SITE_URL}/#organization` },
    encoding: { '@type': 'MediaObject', contentUrl: abs(jsonPath), encodingFormat: 'application/json' },
  },
};
const jsonLd = [breadcrumbLd, personLd];
---
<Base title={title} description={description} path={path} noindex jsonLd={jsonLd} modified={rec.recordCreated}>
  <nav class="crumb" aria-label="Breadcrumb">
    REGISTRY / {rec.recordNumber}
  </nav>

  <div class="rec-page">
    <!-- ---------- The ID block: everything a reader needs at a glance ---------- -->
    <section class="idcard" aria-labelledby="record-name">
      <div class="idcard__grid">
        <figure class="idphoto">
          {photoSrc ? (
            <img
              class="idphoto__img"
              src={photoSrc}
              alt={rec.photo.alt ?? `Photo supplied by ${rec.name}`}
              width="160"
              height="160"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="idphoto__img idphoto__img--empty" role="img" aria-label="No photograph has been supplied for this record.">
              <span aria-hidden="true">NO<br />PHOTO</span>
            </div>
          )}
          <figcaption class="idphoto__cap">photo supplied</figcaption>
        </figure>

        <div class="idcard__who">
          <p class="idcard__kicker">REGISTRY RECORD · {rec.recordNumber}</p>
          <h1 id="record-name">{rec.name}</h1>
          <p class="idcard__alt">Legal name: {rec.nameOnRosters} (as it appears on issuer rosters)</p>

          <dl class="idfacts">
            {rec.activeSince && (
              <div class="idfact">
                <dt>Active in chimney services since</dt>
                <dd>{rec.activeSince}</dd>
              </div>
            )}
            {role && (
              <div class="idfact">
                <dt>Role</dt>
                <dd>{role}</dd>
              </div>
            )}
          </dl>
        </div>
      </div>

      <ul class="idcreds">
        {idCredentials.map((c) => (
          <CredentialRow credential={c} variant="id" />
        ))}
      </ul>

      <p class="idcard__note">
        Certifications checked against the issuers' public rosters on the dates shown. Photo, role and history supplied by
        this person.
      </p>

      <p class="idcard__actions">
        <button type="button" class="button button--ghost" id="open-details">Verify with your AI</button>
      </p>
    </section>

    <!-- ---------- Details: the evidence, collapsed by default ---------- -->
    <details class="details" id="record-details">
      <summary>Details: what was checked, what wasn't, and how to repeat it</summary>
      <div class="details__body">
        <aside class="band band--claim" aria-labelledby="the-claim">
          <p class="band__title" id="the-claim">What this record claims</p>
          <p>{RECORD_CLAIM}</p>
          <p class="fineprint">No status is conferred here. This is a record of dated facts, not a rating, a badge or a recommendation.</p>
          <p class="fineprint">
            Record created <span class="mono">{rec.recordCreated}</span> · last checked <span class="mono">{dateOrDash(rec.lastChecked)}</span>
            {rec.lastChecked ? ` (${shortDate(rec.lastChecked)})` : ''}
          </p>
        </aside>

        <section aria-labelledby="rosters" class="rec-section">
          <h2 id="rosters">Checked against issuer rosters</h2>
          <p class="lede">
            Certification bodies are listed in a fixed order — NCSG, then NFI, then CSIA, then any other body — so that what is
            missing is as visible as what is present.
          </p>
          <p class="fineprint issuer-marks">
            Issuer names and marks are the issuers' trademarks, shown only to identify where the check was run; no endorsement
            by NFI or SPRAT is implied.
          </p>

          {orderedRows.map((row) =>
            row.kind === 'credential' ? (
              <CredentialRow credential={row.credential} variant="evidence" level={3} />
            ) : (
              <p class="cred cred--empty">
                <span class="cred__abbr cred__abbr--empty">{row.issuer}</span>
                <span>{row.issuerName} individual certification: none on record.</span>
              </p>
            ),
          )}

          {otherRows.length > 0 && (
            <>
              <h3 class="rec-subhead">Other bodies</h3>
              {otherRows.map((c) => (
                <CredentialRow credential={c} variant="evidence" level={4} />
              ))}
            </>
          )}
        </section>

        <section aria-labelledby="supplied" class="rec-section">
          <h2 id="supplied">Supplied by this person — not checked</h2>
          <p class="lede">Everything below came from the person named. We have not checked any of it and we do not repeat it as fact.</p>
          <div class="record">
            <dl>
              {rec.activeSince && (
                <>
                  <dt>Active in chimney services since</dt>
                  <dd>{rec.activeSince}</dd>
                </>
              )}
              {rec.role && (
                <>
                  <dt>Role</dt>
                  <dd>{rec.role}{rec.employer ? ` at ${rec.employer}` : ''}</dd>
                </>
              )}
              {rec.supplied.map((f) => (
                <>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </>
              ))}
              <dt>Photograph</dt>
              <dd>A photograph is supplied by the person named and proves nothing. We do not check that a face belongs to a name.</dd>
              <dt>Statement</dt>
              <dd>{rec.suppliedStatement}</dd>
            </dl>
          </div>
        </section>

        <section aria-labelledby="not-checked" class="rec-section">
          <h2 id="not-checked">Not checked</h2>
          <p class="lede">Four things a reader might assume a registry record covers. It covers none of them.</p>
          <ul class="notchecked">
            {rec.notChecked.map((n) => (
              <li>
                <span class="notchecked__label">{n.label}</span>
                <span>{n.why}</span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="verify" class="rec-section">
          <h2 id="verify">Verify this with your own AI</h2>
          <p class="lede">
            Do not take our word for it. Copy the prompt below, paste it into whatever AI assistant you use, and have it do the
            roster checks in front of you — including the ones we have not run.
          </p>
          <div class="verify">
            <label class="verify__label" for="verify-prompt">Prompt — copy and paste</label>
            <textarea id="verify-prompt" class="verify__text" readonly rows="18" spellcheck="false">{prompt}</textarea>
            <p class="verify__actions">
              <button type="button" class="button" id="verify-copy" data-copy-target="verify-prompt">Copy the prompt</button>
              <span class="fineprint" id="verify-copy-status" role="status" aria-live="polite"></span>
            </p>
            <p class="fineprint">
              If the copy button does not work, select the text above and copy it by hand — it is plain text and nothing is hidden in it.
              Machine-readable version of this record: <a href={jsonPath}>{jsonPath}</a>.
            </p>
          </div>
        </section>
      </div>
    </details>

    <div class="rely-compact">
      <BeforeYouRely dateLabel={rec.lastChecked ?? rec.recordCreated} variant="record" />
    </div>
  </div>
</Base>

<style>
  /* Single column, centred, generous whitespace. No rail on this page. */
  .rec-page {
    max-width: 720px;
    margin: 0 auto 8px;
  }

  /* ---------- The ID block ---------- */
  .idcard {
    border: 1px solid var(--ink);
    padding: 22px 22px 20px;
    background: var(--paper);
  }
  @media (min-width: 620px) {
    .idcard {
      padding: 28px 30px 24px;
    }
  }
  .idcard__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px 24px;
    align-items: start;
  }
  @media (min-width: 560px) {
    .idcard__grid {
      grid-template-columns: 160px minmax(0, 1fr);
    }
  }
  .idphoto {
    margin: 0;
    width: 160px;
    max-width: 100%;
  }
  .idphoto__img {
    display: block;
    width: 160px;
    height: 160px;
    max-width: 100%;
    border: 1px solid var(--ink);
    background: var(--panel);
    object-fit: cover;
    object-position: center top;
  }
  .idphoto__img--empty {
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: center;
    line-height: 1.7;
  }
  .idphoto__cap {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-top: 6px;
  }
  .idcard__kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .idcard__who h1 {
    font-size: clamp(1.9rem, 4.6vw, 2.6rem);
    margin: 0 0 6px;
    line-height: 1.08;
  }
  .idcard__alt {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 16px;
  }
  .idfacts {
    margin: 0;
  }
  .idfact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    padding: 4px 0;
  }
  .idfacts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .idfacts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.5;
  }
  .idcreds {
    list-style: none;
    margin: 22px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--ink);
  }
  .idcard__note {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .idcard__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 16px 0 0;
  }

  /* ---------- Details ---------- */
  .details {
    border: 1px solid var(--rule);
    margin-top: 24px;
  }
  .details > summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .details > summary::-webkit-details-marker {
    display: none;
  }
  .details > summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .details[open] > summary {
    border-bottom: 1px solid var(--rule);
  }
  .details[open] > summary::after {
    content: '−';
  }
  .details__body {
    padding: 4px 16px 20px;
  }
  .band--claim {
    margin: 16px 0 0;
  }
  .band--claim p {
    max-width: var(--measure);
  }
  .rec-section {
    margin-top: 36px;
    border-top: 1px solid var(--ink);
    padding-top: 18px;
  }
  .rec-section > h2 {
    margin-bottom: 8px;
    font-size: 1.4rem;
  }
  .rec-section > .lede {
    color: var(--muted);
    font-size: 1rem;
    margin-bottom: 18px;
  }
  .issuer-marks {
    color: var(--muted);
    max-width: var(--measure);
    margin: -8px 0 18px;
  }
  .rec-subhead {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 28px 0 10px;
  }
  .cred--empty {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: baseline;
    border: 1px dashed var(--rule);
    color: var(--muted);
    padding: 10px 16px;
    margin: 0 0 12px;
  }
  .cred__abbr--empty {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    border: 1px solid var(--rule);
    color: var(--muted);
    padding: 3px 6px;
  }
  .notchecked {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
    max-width: var(--measure);
  }
  .notchecked li {
    display: grid;
    gap: 2px 20px;
    grid-template-columns: minmax(0, 1fr);
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 620px) {
    .notchecked li {
      grid-template-columns: 170px minmax(0, 1fr);
    }
  }
  .notchecked__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .verify {
    border: 1px solid var(--ink);
    padding: 14px 16px;
    max-width: var(--measure);
  }
  .verify__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .verify__text {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    padding: 12px;
    border: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink);
    border-radius: 0;
    resize: vertical;
  }
  .verify__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    margin: 12px 0 8px;
  }

  /* The closing band stays, but quieter than the ID block above it. */
  .rely-compact :global(.box) {
    margin: 24px 0 0;
  }
  .rely-compact :global(.prose li) {
    font-size: 0.86rem;
    line-height: 1.5;
  }
</style>

<script is:inline>
  (function () {
    var details = document.getElementById('record-details');
    var open = document.getElementById('open-details');
    if (details && open) {
      open.addEventListener('click', function () {
        details.open = true;
        var target = document.getElementById('verify');
        if (target && target.scrollIntoView) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
    // A link into Details from anywhere else must not land on a closed box.
    if (details) {
      var openForHash = function () {
        var id = (location.hash || '').slice(1);
        if (!id) return;
        var el = document.getElementById(id);
        if (el && details.contains(el)) details.open = true;
      };
      openForHash();
      window.addEventListener('hashchange', openForHash);
    }

    var btn = document.getElementById('verify-copy');
    if (!btn) return;
    var status = document.getElementById('verify-copy-status');
    btn.addEventListener('click', function () {
      var field = document.getElementById(btn.getAttribute('data-copy-target'));
      if (!field) return;
      var done = function (msg) {
        if (status) status.textContent = msg;
      };
      var text = field.value;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(
          function () { done('Copied. Paste it into your AI assistant.'); },
          function () { field.select(); done('Could not copy for you — the text is selected, press Ctrl/Cmd+C.'); },
        );
      } else {
        field.select();
        done('The text is selected — press Ctrl/Cmd+C to copy.');
      }
    });
  })();
</script>
