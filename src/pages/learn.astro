---
import Base from '../layouts/Base.astro';
import { ORG_NAME, SITE_URL, abs } from '../lib/site';

const path = '/learn';
const title = `Learn: Chimney Guides, Planned Topics | ${ORG_NAME}`;
const description = 'Chimney.Services Learn: planned guides to chimney inspections, sweeping, rain caps, crowns, flue liners and creosote. Not yet published.';
const topics = [
  { slug: 'chimney-inspection', t: 'Chimney inspections', d: 'What NFPA 211 Level 1, 2 and 3 inspections cover, when each is appropriate, and how to read a report.' },
  { slug: 'chimney-sweeping', t: 'Chimney sweeping', d: 'What a sweep visit includes, how often to schedule one, and what to expect to be shown.' },
  { slug: 'rain-caps', t: 'Chimney rain caps', d: 'Types, materials, and when a cap needs replacing rather than repair.' },
  { slug: 'chimney-crown', t: 'Chimney crowns', d: 'What a crown does, how cracks are diagnosed, and repair versus rebuild.' },
  { slug: 'flue-liners', t: 'Flue liners', d: 'Clay, stainless and cast-in-place liners, and when relining is actually needed.' },
  { slug: 'creosote', t: 'Creosote', d: 'How creosote builds up, the stages, and how it is removed.' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ORG_NAME, item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: abs(path) },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} section="learn">
  <nav class="crumb" aria-label="Breadcrumb">CHIMNEY.SERVICES / LEARN</nav>
  <h1>Chimney guides we're writing next</h1>
  <p class="lede">One page per topic, grown in place, each read dated and sourced. None of these guides is published yet — this list is the plan, not a table of contents.</p>
  <ul class="topic-list" aria-label="Planned topics">
    {topics.map((x, i) => (
      <li id={x.slug}>
        <p class="kicker">Planned · {String(i + 1).padStart(2, '0')}</p>
        <h2 style="font-size:1.35rem;margin:0 0 4px">{x.t}</h2>
        <p style="margin:0">{x.d}</p>
      </li>
    ))}
  </ul>
  <p style="margin-top:24px">Until then, the <a href="/rights">state-by-state laws reference</a> is live.</p>
</Base>
